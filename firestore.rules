rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public read on challenges so citizens, researchers, and departments can discover problems
    // Authenticated users can submit, and officials/submitters can update
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if isAuthenticated() || true; // Allow prototype submissions
      allow update: if isAuthenticated() || true; // Prototype updates
      allow delete: if isAuthenticated();
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || true;
    }

    // Solution proposals
    match /solution_proposals/{proposalId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() || true;
    }
  }
}
